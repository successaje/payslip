{
  "name": "payslip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:push:mainnet": "dotenv -e .env.mainnet.local -- drizzle-kit push",
    "dev:mainnet": "dotenv -e .env.mainnet.local -- next dev -p 3201",
    "preflight:mainnet": "tsx scripts/mainnet-preflight.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@softseco/confidential-transfers": "^3.0.0",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana-program/zk-elgamal-proof": "^0.4.0",
    "@solana/kit": "^8.3.0",
    "@solana/react": "^8.3.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/react": "^1.0.3",
    "@wallet-standard/wallet": "^1.1.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "Private USDC payouts on Solana. Salaries, invoices, grants and bounties with amounts encrypted on-chain, readable only by the recipient and the auditor."
}
