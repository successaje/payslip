# Solana cluster the app talks to. "devnet" or "mainnet-beta".
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoints. The public devnet endpoint rate-limits proof transactions;
# a Helius or Triton endpoint is strongly recommended.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_RPC_WS_URL=wss://api.devnet.solana.com

# USDC mint the vault wraps. Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v.
# Devnet: Circle's devnet USDC is 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU, or any
# 6-decimal test mint you control (the devnet demo uses 3hm3Rq94Dyaj2CFY2RZdWccjbyeoBDKwB1mmxrwprvtx).
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Deployed payslip_vault program. Devnet: AjfdhEkypXPzBfxHL4rhX9UNMpzWbD51D56U8XVhcX2L
NEXT_PUBLIC_VAULT_PROGRAM_ID=AjfdhEkypXPzBfxHL4rhX9UNMpzWbD51D56U8XVhcX2L

# Database. A local file in development; a Turso URL + token in production.
DATABASE_URL=file:./data/payslip.db
DATABASE_AUTH_TOKEN=

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public origin, used in sign-in messages and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3200
