# Mainnet run. Copy to .env.mainnet.local, fill in, then `npm run dev:mainnet`
# (serves on http://localhost:3201 so it never shares a session with devnet).
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# A keyed RPC (Helius, Triton, QuickNode). The public endpoint rate-limits
# proof transactions and may reject Transaction V1 reads.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RPC_WS_URL=

# Circle USDC on mainnet.
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Same program keypair as devnet, so the address is the same once deployed.
NEXT_PUBLIC_VAULT_PROGRAM_ID=AjfdhEkypXPzBfxHL4rhX9UNMpzWbD51D56U8XVhcX2L

# Separate database so mainnet workspaces never mix with devnet test data.
DATABASE_URL=file:./data/payslip-mainnet.db
DATABASE_AUTH_TOKEN=

# openssl rand -base64 32
SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3201
# Never on mainnet. The dev wallet refuses to register unless the cluster is devnet anyway.
NEXT_PUBLIC_ENABLE_DEV_WALLET=false
